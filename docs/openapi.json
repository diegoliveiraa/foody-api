  "components" : {
    "schemas" : {
      "AdminUserResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "disabledAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "CUSTOMER", "STAFF", "ADMIN" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        },
        "required" : [ "createdAt", "email", "id", "name", "role", "status" ]
      },
      "AuthResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "accessToken", "expiresIn" ]
      },
      "CartItem" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 20,
            "minimum" : 1
          }
        },
        "required" : [ "productId", "quantity" ]
      },
      "CartQuote" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/QuotedItem"
            }
          },
          "total" : {
            "type" : "number"
          }
        },
        "required" : [ "items", "total" ]
      },
      "CategoryRequest" : {
        "type" : "object",
        "properties" : {
          "displayOrder" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 999,
            "minimum" : 0
          },
          "name" : {
            "type" : "string",
            "maxLength" : 60,
            "minLength" : 2
          }
        },
        "required" : [ "displayOrder", "name" ]
      },
      "CategoryResponse" : {
        "type" : "object",
        "properties" : {
          "disabledAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "displayOrder" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "productCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        },
        "required" : [ "displayOrder", "id", "name", "productCount", "status" ]
      },
      "ChangeRoleRequest" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "enum" : [ "CUSTOMER", "STAFF", "ADMIN" ]
          }
        },
        "required" : [ "role" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ]
      },
      "MeModule" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "screens" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MeScreen"
            }
          }
        },
        "required" : [ "key", "label", "screens" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "modules" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MeModule"
            }
          },
          "user" : {
            "$ref" : "#/components/schemas/MeUser"
          }
        },
        "required" : [ "modules", "user" ]
      },
      "MeScreen" : {
        "type" : "object",
        "properties" : {
          "actions" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "PLACE_ORDER", "CANCEL", "REQUEST_CANCELLATION", "UPDATE_STATUS", "DECIDE_CANCELLATION", "CREATE", "UPDATE", "DISABLE", "DELETE" ]
            }
          },
          "key" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "actions", "key", "label" ]
      },
      "MeUser" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "id", "name" ]
      },
      "MenuCategory" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
