{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Foody API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/admin/users" : {
      "get" : {
        "operationId" : "list",
        "parameters" : [ {
          "in" : "query",
          "name" : "search",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "role",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "CUSTOMER", "STAFF", "ADMIN" ]
          }
        }, {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1,
            "minimum" : 1
          }
        }, {
          "in" : "query",
          "name" : "pageSize",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 10,
            "enum" : [ 10, 25, 50, 100 ]
          }
        }, {
          "description" : "property,asc or property,desc; repeat it to sort by more than one property",
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "admin-user-controller" ]
      }
    },
    "/admin/users/{id}/disable" : {
      "post" : {
        "operationId" : "disable",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "admin-user-controller" ]
      }
    },
    "/admin/users/{id}/enable" : {
      "post" : {
        "operationId" : "enable",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "admin-user-controller" ]
      }
    },
    "/admin/users/{id}/role" : {
      "patch" : {
        "operationId" : "changeRole",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangeRoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "admin-user-controller" ]
      }
    },
    "/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "foody_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "foody_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "me-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AdminUserResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "disabledAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "CUSTOMER", "STAFF", "ADMIN" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        },
        "required" : [ "createdAt", "email", "id", "name", "role", "status" ]
      },
      "AuthResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "accessToken", "expiresIn" ]
      },
      "ChangeRoleRequest" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "enum" : [ "CUSTOMER", "STAFF", "ADMIN" ]
          }
        },
        "required" : [ "role" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ]
      },
      "MeModule" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "screens" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MeScreen"
            }
          }
        },
        "required" : [ "key", "label", "screens" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "modules" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MeModule"
            }
          },
          "user" : {
            "$ref" : "#/components/schemas/MeUser"
          }
        },
        "required" : [ "modules", "user" ]
      },
      "MeScreen" : {
        "type" : "object",
        "properties" : {
          "actions" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "PLACE_ORDER", "CANCEL", "REQUEST_CANCELLATION", "UPDATE_STATUS", "DECIDE_CANCELLATION", "CREATE", "UPDATE", "DISABLE", "DELETE" ]
            }
          },
          "key" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "actions", "key", "label" ]
      },
      "MeUser" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "id", "name" ]
      },
      "PageMeta" : {
        "type" : "object",
        "properties" : {
          "hasNext" : {
            "type" : "boolean"
          },
          "hasPrevious" : {
            "type" : "boolean"
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "pageSize" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "hasNext", "hasPrevious", "page", "pageSize", "totalItems", "totalPages" ]
      },
      "PageResponseAdminUserResponse" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AdminUserResponse"
            }
          },
          "meta" : {
            "$ref" : "#/components/schemas/PageMeta"
          }
        },
        "required" : [ "data", "meta" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 2
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "name", "password" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}